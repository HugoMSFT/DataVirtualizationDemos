<Window x:Class="ProClickConfigurator.Mac.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ProClickConfigurator.Mac.Controls"
        Title="Pro Click Mini Configurator"
        Width="1080"
        Height="740"
        MinWidth="920"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="#F8FAFC"
        FontFamily="Inter">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#111A2D" />
        <SolidColorBrush x:Key="CardRaisedBrush" Color="#182338" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3850" />
        <SolidColorBrush x:Key="TextBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#14B8A6" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource CardRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentStrongBrush}" />
            <Setter Property="Foreground" Value="#062A27" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource CardRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="82,*,68">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="30,18,30,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44"
                        Height="44"
                        Background="{StaticResource AccentStrongBrush}"
                        CornerRadius="13">
                    <TextBlock Text="PC"
                               Foreground="#062A27"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PRO CLICK MINI"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Configurator"
                               FontSize="25"
                               FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Padding="13,8"
                        Margin="0,0,12,0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" />
                </Border>
                <Border Padding="13,8"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <TextBlock Text="{Binding BatteryLabel}" FontWeight="Bold" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="0.9*,1.1*" Margin="30,0,30,18">
            <Border Grid.Column="0" Classes="card" Margin="0,0,10,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel>
                        <TextBlock Text="BUTTON MAP"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Select a control"
                                   Margin="0,5,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Click a highlighted button on the mouse photo."
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <Viewbox Grid.Row="1" Margin="0,8" Stretch="Uniform">
                        <controls:MouseDiagram SelectedButton="{Binding SelectedButton}"
                                               ButtonSelected="OnMouseButtonSelected" />
                    </Viewbox>

                    <Border Grid.Row="2"
                            Padding="12,10"
                            Background="{StaticResource CardRaisedBrush}"
                            CornerRadius="10">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Text="The small button below the wheel is the fixed scroll-mode switch." />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Margin="10,0,0,0">
                <TabControl>
                    <TabItem Header="Assignments">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,6,10,10">
                                <TextBlock Text="SELECTED CONTROL"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding SelectedAssignment.DisplayName}"
                                           Margin="0,5,0,16"
                                           FontSize="27"
                                           FontWeight="SemiBold" />

                                <Border Padding="14"
                                        Margin="0,0,0,20"
                                        Background="{StaticResource CardRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="ONBOARD ASSIGNMENTS"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding AssignmentStorageLabel}"
                                                   Margin="0,4,0,0"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Read imports both layers; Apply stores them in mouse memory."
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Primary action" Margin="0,0,0,7" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding AvailablePrimaryActions}"
                                          IsEnabled="{Binding SelectedAssignment.CanAssignPrimaryAction}"
                                          SelectedItem="{Binding SelectedAssignment.PrimaryAction}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SelectionLabel}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,7,0,0"
                                           Text="Locked: normal left click is always preserved."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           IsVisible="{Binding SelectedAssignment.IsPrimaryActionLocked}" />

                                <TextBlock Text="HyperShift action" Margin="0,18,0,7" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding HyperShiftActions}"
                                          IsEnabled="{Binding SelectedAssignment.CanAssignHyperShiftAction}"
                                          SelectedItem="{Binding SelectedAssignment.HyperShiftAction}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SelectionLabel}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Preset name" Margin="0,20,0,7" FontWeight="SemiBold" />
                                <TextBox Text="{Binding ProfileName}" />
                                <TextBlock Text="Saved presets" Margin="0,16,0,7" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <ComboBox ItemsSource="{Binding PresetNames}"
                                              SelectedItem="{Binding SelectedPresetName}" />
                                    <Button Grid.Column="1"
                                            Content="Load"
                                            Margin="8,0,0,0"
                                            Command="{Binding LoadPresetCommand}" />
                                    <Button Grid.Column="2"
                                            Content="Save"
                                            Margin="8,0,0,0"
                                            Command="{Binding SaveProfileCommand}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Performance">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,6,10,10">
                                <TextBlock Text="CURRENT DPI"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding CurrentDpi, StringFormat={}{0:N0} DPI}"
                                           Margin="0,5,0,4"
                                           FontSize="32"
                                           FontWeight="SemiBold" />
                                <Slider Minimum="100"
                                        Maximum="12000"
                                        TickFrequency="100"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding CurrentDpi}" />

                                <Grid ColumnDefinitions="*,160" Margin="0,24,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Polling rate" FontWeight="SemiBold" />
                                        <TextBlock Text="Receiver report frequency"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding PollingRates}"
                                              SelectedItem="{Binding PollingRateHz}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,24,0,10">
                                    <TextBlock Text="DPI stages"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="+ Add"
                                            Command="{Binding AddDpiStageCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding DpiStages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="70,*,90,Auto" Margin="0,5">
                                                <TextBlock Text="{Binding Number, StringFormat=Stage {0}}"
                                                           VerticalAlignment="Center" />
                                                <Slider Grid.Column="1"
                                                        Minimum="100"
                                                        Maximum="12000"
                                                        TickFrequency="100"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Value}"
                                                        Margin="8,0" />
                                                <NumericUpDown Grid.Column="2"
                                                               Minimum="100"
                                                               Maximum="12000"
                                                               Increment="100"
                                                               Value="{Binding Value}" />
                                                <Button Grid.Column="3"
                                                        Content="-"
                                                        Tag="{Binding}"
                                                        Margin="8,0,0,0"
                                                        Click="OnRemoveDpiStage" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*,160" Margin="0,20,0,0">
                                    <TextBlock Text="Active DPI stage" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ActiveDpiStageChoices}"
                                              SelectedItem="{Binding ActiveDpiStage}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Power">
                        <StackPanel Margin="4,6,10,10">
                            <TextBlock Text="BATTERY AND POWER"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding BatteryLabel}"
                                       Margin="0,5,0,24"
                                       FontSize="32"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Sleep after" Margin="0,0,0,7" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding IdleTimeOptions}"
                                      SelectedItem="{Binding IdleTimeSeconds}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0} seconds}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Low-battery warning" Margin="0,22,0,7" FontWeight="SemiBold" />
                            <NumericUpDown Minimum="5"
                                           Maximum="25"
                                           Increment="1"
                                           Value="{Binding LowBatteryThresholdPercent}" />

                            <Border Padding="14"
                                    Margin="0,24,0,0"
                                    Background="{StaticResource CardRaisedBrush}"
                                    CornerRadius="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Firmware" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FirmwareVersion}"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="30,0,30,18">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Read from mouse"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshDeviceCommand}" />
                <Button Content="Apply to mouse"
                        Classes="primary"
                        Command="{Binding ApplyToMouseCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
