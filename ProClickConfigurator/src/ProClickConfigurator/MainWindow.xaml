<Window x:Class="ProClickConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ProClickConfigurator.Controls"
        Title="Pro Click Mini Configurator"
        Width="1020"
        Height="680"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Grid Margin="30,18,30,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="44"
                        Height="44"
                        Background="{StaticResource AccentStrongBrush}"
                        CornerRadius="13">
                    <Grid>
                        <Path Width="22"
                              Height="26"
                              Stretch="Fill"
                              Fill="#062A27"
                              Data="M11,1 C5,1 2,6 2,12 L2,17 C2,23 6,25 11,25 C16,25 20,23 20,17 L20,12 C20,6 17,1 11,1 Z M11,2 L11,10"
                              Stroke="#062A27"
                              StrokeThickness="1.5" />
                    </Grid>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PRO CLICK MINI"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Configurator"
                               FontSize="25"
                               FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border Padding="13,8"
                        Margin="0,0,12,0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,9,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Padding="13,8"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="24" Height="13" Margin="0,0,8,0">
                            <Border BorderBrush="{StaticResource MutedTextBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="2" />
                            <Border Width="3"
                                    Height="7"
                                    Margin="24,0,-3,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource MutedTextBrush}"
                                    CornerRadius="0,2,2,0" />
                            <Border Margin="3"
                                    HorizontalAlignment="Left"
                                    Width="16"
                                    Background="{StaticResource AccentBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding BatteryLabel}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="30,0,30,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.92*" />
                <ColumnDefinition Width="1.08*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="BUTTON MAP"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Select a control"
                                   Margin="0,5,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Click a highlighted button on the mouse photo."
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <Viewbox Grid.Row="1"
                             Margin="0,8"
                             Stretch="Uniform">
                        <controls:MouseDiagram x:Name="MouseDiagramControl"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               SelectedButton="{Binding SelectedButton, Mode=OneWay}"
                                               ButtonSelected="OnMouseButtonSelected" />
                    </Viewbox>

                    <Border Grid.Row="2"
                            Padding="12,10"
                            Background="{StaticResource CardRaisedBrush}"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28"
                                    Height="28"
                                    Background="#24354B"
                                    CornerRadius="8">
                                <TextBlock Text="i"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="The small button below the wheel is the fixed, non-assignable scroll-mode switch." />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Margin="10,0,0,0">
                <TabControl>
                    <TabItem Header="Assignments">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,4,8,8">
                                <TextBlock Text="SELECTED CONTROL"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding SelectedAssignment.DisplayName}"
                                           Margin="0,5,0,16"
                                           FontSize="28"
                                           FontWeight="SemiBold" />

                                <Border Margin="0,0,0,22"
                                        Padding="14"
                                        Background="{StaticResource CardRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="ONBOARD ASSIGNMENTS"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="{Binding AssignmentStorageLabel}"
                                                   Margin="0,4,0,0"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Read from mouse imports both layers. Apply to mouse stores the current choices in mouse memory."
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Primary action"
                                           Margin="0,0,0,7"
                                           FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding AvailablePrimaryActions}"
                                          IsEnabled="{Binding SelectedAssignment.CanAssignPrimaryAction}"
                                          SelectedItem="{Binding SelectedAssignment.PrimaryAction, Mode=TwoWay}"
                                          DisplayMemberPath="SelectionLabel" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="Locked: normal left click is always preserved."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Visibility="{Binding SelectedAssignment.IsPrimaryActionLocked, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <TextBlock Text="HyperShift action"
                                           Margin="0,20,0,7"
                                           FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding HyperShiftActions}"
                                          IsEnabled="{Binding SelectedAssignment.CanAssignHyperShiftAction}"
                                          SelectedItem="{Binding SelectedAssignment.HyperShiftAction, Mode=TwoWay}"
                                          DisplayMemberPath="SelectionLabel" />

                                <Border Margin="0,22,0,0"
                                        Padding="15"
                                        Background="#13263A"
                                        BorderBrush="#235C5A"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="HOW HYPERSHIFT WORKS"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Margin="0,7,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Assign “HyperShift modifier” as a primary action on any pressable button. Hold it while pressing another control to run that control's HyperShift action." />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Local profile name"
                                           Margin="0,24,0,7"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Saved presets"
                                           Margin="0,18,0,7"
                                           FontWeight="SemiBold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding PresetNames}"
                                              SelectedItem="{Binding SelectedPresetName, Mode=TwoWay}"
                                              MinWidth="180" />
                                    <Button Grid.Column="1"
                                            Content="Load"
                                            Margin="8,0,0,0"
                                            Command="{Binding LoadPresetCommand}" />
                                    <Button Grid.Column="2"
                                            Content="Save preset"
                                            Margin="8,0,0,0"
                                            Command="{Binding SaveProfileCommand}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Performance">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,4,8,8">
                                <TextBlock Text="CURRENT DPI"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,2">
                                    <TextBlock Text="{Binding CurrentDpi, StringFormat={}{0:N0}}"
                                               FontSize="34"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" DPI"
                                               Margin="4,12,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <Slider Minimum="100"
                                        Maximum="12000"
                                        Value="{Binding CurrentDpi, Mode=TwoWay}"
                                        TickFrequency="100"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,4,0,4" />
                                <Grid>
                                    <TextBlock Text="100"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="12,000"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </Grid>

                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Polling rate"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Receiver report frequency"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding PollingRates}"
                                              SelectedItem="{Binding PollingRateHz, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,26,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DPI stages"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Up to five stages are stored on the mouse."
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="+ Add stage"
                                            Command="{Binding AddDpiStageCommand}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DpiStages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number, StringFormat=Stage {0}}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}" />
                                                <Slider Grid.Column="1"
                                                        Margin="8,0,14,0"
                                                        Minimum="100"
                                                        Maximum="12000"
                                                        TickFrequency="100"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding Value, Mode=TwoWay}" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Value, StringFormat={}{0:N0}}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           FontWeight="SemiBold" />
                                                <Button Grid.Column="3"
                                                        Margin="10,0,0,0"
                                                        Padding="9,5"
                                                        Content="×"
                                                        Command="{Binding DataContext.RemoveDpiStageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Active stage"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Selected after saving"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding ActiveDpiStageChoices}"
                                              SelectedItem="{Binding ActiveDpiStage, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Power">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,4,8,8">
                                <TextBlock Text="BATTERY"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding BatteryLabel}"
                                           Margin="0,5,0,8"
                                           FontSize="38"
                                           FontWeight="SemiBold" />
                                <ProgressBar Height="10"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding BatteryPercent, Mode=OneWay}"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="#26354A" />
                                <TextBlock Margin="0,9,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Battery telemetry is available through the 2.4 GHz receiver." />

                                <Grid Margin="0,30,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Sleep after"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Idle power timeout"
                                                   Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding IdleTimeOptions}"
                                              SelectedItem="{Binding IdleTimeSeconds, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0} seconds}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <TextBlock Text="Low-battery warning"
                                           Margin="0,28,0,0"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LowBatteryThresholdPercent, StringFormat={}{0}%}"
                                           Margin="0,5,0,0"
                                           FontSize="26"
                                           FontWeight="SemiBold" />
                                <Slider Minimum="5"
                                        Maximum="25"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding LowBatteryThresholdPercent, Mode=TwoWay}" />

                                <Border Margin="0,30,0,0"
                                        Padding="15"
                                        Background="{StaticResource CardRaisedBrush}"
                                        CornerRadius="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Receiver firmware"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FirmwareVersion}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Margin="30,0,30,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Read from mouse"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshDeviceCommand}" />
                <Button Content="Apply to mouse"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ApplyToMouseCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
