<UserControl x:Class="ProClickConfigurator.Controls.MouseDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:ProClickConfigurator.Core.Models;assembly=ProClickConfigurator.Core"
             Width="430"
             Height="500">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MouseSurfaceBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="MouseSecondaryBrush" Color="#DCE3EA" />
        <SolidColorBrush x:Key="MouseStrokeBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#CC2DD4BF" />
        <SolidColorBrush x:Key="SelectedStrokeBrush" Color="#5EEAD4" />
        <Style x:Key="ClickableMousePart" TargetType="Path">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Stroke" Value="{StaticResource MouseStrokeBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Fill" Value="{StaticResource MouseSurfaceBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Canvas Width="430" Height="480">
            <Ellipse Canvas.Left="122"
                     Canvas.Top="432"
                     Width="186"
                     Height="24"
                     Fill="#40000000">
                <Ellipse.Effect>
                    <BlurEffect Radius="17" />
                </Ellipse.Effect>
            </Ellipse>

            <Path Data="M215,36 C176,36 151,52 143,80 C136,108 136,170 134,224 L120,337 C114,393 155,435 215,443 C275,435 316,393 310,337 L296,224 C294,170 294,108 287,80 C279,52 254,36 215,36 Z"
                  Fill="#EEF2F6"
                  Stroke="#64748B"
                  StrokeThickness="2">
                <Path.Effect>
                    <DropShadowEffect BlurRadius="22"
                                      Direction="270"
                                      ShadowDepth="10"
                                      Color="#111827"
                                      Opacity="0.55" />
                </Path.Effect>
            </Path>

            <Path x:Name="LeftPart"
                  Tag="{x:Static core:MouseButtonId.Left}"
                  Style="{StaticResource ClickableMousePart}"
                  Data="M213,43 C181,43 159,57 151,83 C146,105 144,145 143,181 L199,186 L209,168 L209,47 Z"
                  ToolTip="Left click"
                  MouseLeftButtonDown="OnPartClicked" />
            <Path x:Name="RightPart"
                  Tag="{x:Static core:MouseButtonId.Right}"
                  Style="{StaticResource ClickableMousePart}"
                  Data="M217,43 C249,43 271,57 279,83 C284,105 286,145 287,181 L231,186 L221,168 L221,47 Z"
                  ToolTip="Right click"
                  MouseLeftButtonDown="OnPartClicked" />

            <Path Data="M143,183 C160,193 179,197 199,198 M231,198 C251,197 270,193 287,183"
                  Stroke="#CBD5E1"
                  StrokeThickness="2"
                  Fill="Transparent" />
            <Path Data="M215,42 L215,70"
                  Stroke="#CBD5E1"
                  StrokeThickness="2" />

            <Border Canvas.Left="193"
                    Canvas.Top="66"
                    Width="44"
                    Height="112"
                    Background="#D8E0E8"
                    CornerRadius="20"
                    BorderBrush="#94A3B8"
                    BorderThickness="1.5" />
            <Path x:Name="MiddlePart"
                  Tag="{x:Static core:MouseButtonId.Middle}"
                  Style="{StaticResource ClickableMousePart}"
                  Fill="#B8C1CC"
                  Data="M205,75 C200,75 198,79 198,85 L198,145 C198,153 204,159 215,159 C226,159 232,153 232,145 L232,85 C232,79 230,75 225,75 Z"
                  ToolTip="Wheel click"
                  MouseLeftButtonDown="OnPartClicked" />
            <Path Data="M205,88 L225,88 M205,98 L225,98 M205,108 L225,108 M205,118 L225,118 M205,128 L225,128 M205,138 L225,138"
                  Stroke="#64748B"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  IsHitTestVisible="False" />

            <Path x:Name="TiltLeftPart"
                  Tag="{x:Static core:MouseButtonId.TiltLeft}"
                  Style="{StaticResource ClickableMousePart}"
                  Fill="{StaticResource MouseSecondaryBrush}"
                  Data="F0 M174,111 A16,16 0 1 0 174,143 A16,16 0 1 0 174,111 M178,118 L169,127 L178,136 Z"
                  ToolTip="Wheel tilt left"
                  MouseLeftButtonDown="OnPartClicked" />
            <Path x:Name="TiltRightPart"
                  Tag="{x:Static core:MouseButtonId.TiltRight}"
                  Style="{StaticResource ClickableMousePart}"
                  Fill="{StaticResource MouseSecondaryBrush}"
                  Data="F0 M256,111 A16,16 0 1 0 256,143 A16,16 0 1 0 256,111 M252,118 L261,127 L252,136 Z"
                  ToolTip="Wheel tilt right"
                  MouseLeftButtonDown="OnPartClicked" />

            <Border Canvas.Left="205"
                    Canvas.Top="185"
                    Width="20"
                    Height="36"
                    Background="#D6DDE5"
                    BorderBrush="#94A3B8"
                    BorderThickness="1.5"
                    CornerRadius="9"
                    ToolTip="Fixed scroll-mode switch (not assignable)">
                <Ellipse Width="5"
                         Height="5"
                         Fill="#64748B"
                         VerticalAlignment="Top"
                         Margin="0,7,0,0" />
            </Border>
            <Path Data="M215,226 L215,264"
                  Stroke="#94A3B8"
                  StrokeThickness="2"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />

            <Path Data="M134,214 C130,250 126,292 120,337 C115,380 137,416 169,432 L177,291 C178,259 159,225 134,214 Z"
                  Fill="#B8C0C9"
                  Stroke="#8C98A6"
                  StrokeThickness="1.5" />
            <Path Data="M296,214 C300,250 304,292 310,337 C315,380 293,416 261,432 L253,291 C252,259 271,225 296,214 Z"
                  Fill="#BEC6CF"
                  Stroke="#8C98A6"
                  StrokeThickness="1.5" />
            <Path Data="M177,291 C193,299 237,299 253,291"
                  Fill="Transparent"
                  Stroke="#CBD5E1"
                  StrokeThickness="1.5" />

            <Path x:Name="ForwardPart"
                  Tag="{x:Static core:MouseButtonId.Forward}"
                  Style="{StaticResource ClickableMousePart}"
                  Fill="{StaticResource MouseSecondaryBrush}"
                  Data="M133,184 C127,186 124,193 124,205 L124,221 C124,229 129,233 134,229 L143,219 C147,214 147,202 142,194 Z"
                  ToolTip="Side forward"
                  MouseLeftButtonDown="OnPartClicked" />
            <Path x:Name="BackPart"
                  Tag="{x:Static core:MouseButtonId.Back}"
                  Style="{StaticResource ClickableMousePart}"
                  Fill="{StaticResource MouseSecondaryBrush}"
                  Data="M127,230 C122,233 120,241 120,252 L120,270 C120,278 125,281 130,276 L140,264 C145,258 145,245 140,238 Z"
                  ToolTip="Side back"
                  MouseLeftButtonDown="OnPartClicked" />

            <TextBlock Canvas.Left="166"
                       Canvas.Top="75"
                       Text="1"
                       Foreground="#334155"
                       FontWeight="Bold"
                       IsHitTestVisible="False" />
            <TextBlock Canvas.Left="256"
                       Canvas.Top="75"
                       Text="2"
                       Foreground="#334155"
                       FontWeight="Bold"
                       IsHitTestVisible="False" />
            <TextBlock Canvas.Left="211"
                       Canvas.Top="163"
                       Text="3"
                       Foreground="#334155"
                       FontWeight="Bold"
                       IsHitTestVisible="False" />
            <TextBlock Canvas.Left="119"
                       Canvas.Top="248"
                       Text="4"
                       Foreground="#334155"
                       FontWeight="Bold"
                       IsHitTestVisible="False" />
            <TextBlock Canvas.Left="124"
                       Canvas.Top="198"
                       Text="5"
                       Foreground="#334155"
                       FontWeight="Bold"
                       IsHitTestVisible="False" />
            <TextBlock Canvas.Left="168"
                       Canvas.Top="120"
                       Text="6"
                       Foreground="#334155"
                       FontWeight="Bold"
                       IsHitTestVisible="False" />
            <TextBlock Canvas.Left="250"
                       Canvas.Top="120"
                       Text="7"
                       Foreground="#334155"
                       FontWeight="Bold"
                       IsHitTestVisible="False" />

        </Canvas>
    </Grid>
</UserControl>
